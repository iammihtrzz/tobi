[Script]

iOS Location Spoofer = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/iammihtrzz/rin/refs/heads/json/locationspoofer.js,argument=mode=response&latitude=-48.876667&longitude=-123.393333&horizontalAccuracy=39&verticalAccuracy=1000&altitude=530&debug=false
